    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.129.0"
  }
