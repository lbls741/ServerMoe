# Release 专用：构建上下文 = release workflow 产出的运行时包
# （servermoe-*-runtime.tar.gz 解包后的 servermoe/ 目录，内含 src/ node_modules/
# package.json LICENSE THIRD-PARTY-NOTICES.md），镜像内容与产物压缩包一致，
# 不重复安装依赖。本地源码构建请用根目录 Dockerfile（自动 bun install）。
FROM oven/bun:1.4

# 官方发布镜像由 release workflow 传入 tag（如 0.2.1）；缺省为空 = 自构建，应用将跳过更新检测
ARG MOE_VERSION=
WORKDIR /app
ENV NODE_ENV=production MOE_DATA_DIR=/data MOE_PORT=8080 MOE_VERSION=${MOE_VERSION}
COPY . .
LABEL org.opencontainers.image.title="ServerMoe" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.description="私有部署微信消息网关（ServerChan 兼容推送 + 关键词路由）" \
      org.opencontainers.image.source="https://github.com/lbls741/ServerMoe"
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.MOE_PORT || process.env.SSC_PORT||'8080')+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["bun", "run", "src/index.ts"]
