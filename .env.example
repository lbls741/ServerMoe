# 主密钥：用于加密落盘的账号凭据。
# 未设置时网关会自动生成 data/secret.key；请务必持久化 data 卷，丢弃它将无法解密已存凭据。
# SSC_SECRET=change-me-to-a-long-random-string

# 管理令牌：Web UI 与管理接口鉴权。未设置时首启生成并打印一次。
# SSC_ADMIN_TOKEN=change-me

SSC_PORT=8080
SSC_DATA_DIR=data
# SSC_LOG_LEVEL=info

# 单条推送分块上限（字符，行边界切分，1800–4000）
# SSC_TEXT_CHUNK_LIMIT=3000

# 每 sendkey 每小时推送限额 / 突发容量
# SSC_SEND_RATE_PER_HOUR=60
# SSC_SEND_BURST=10

# 可绑定账号数上限
# SSC_SEAT_LIMIT=5
