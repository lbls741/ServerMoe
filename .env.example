# 主密钥：用于加密落盘的账号凭据。
# 未设置时网关会自动生成 data/secret.key；请务必持久化 data 卷，丢弃它将无法解密已存凭据。
# MOE_SECRET=change-me-to-a-long-random-string

# 管理令牌：Web UI 与管理接口鉴权。未设置时首启生成并打印一次。
# MOE_ADMIN_TOKEN=change-me

MOE_PORT=8080
MOE_DATA_DIR=data
# MOE_LOG_LEVEL=info

# 单条推送分块上限（字符，行边界切分，1800–4000）
# MOE_TEXT_CHUNK_LIMIT=3000

# 每 sendkey 每小时推送限额 / 突发容量
# MOE_SEND_RATE_PER_HOUR=60
# MOE_SEND_BURST=10

# 可绑定账号数上限
# MOE_SEAT_LIMIT=5

# 更新检测：官方镜像由 Release 流程自动注入版本号；源码/自构建部署默认不检测。
# 裸金属部署如需启用更新检测，可手动设置（须与实际版本一致，三段式如 0.1.1）
# MOE_VERSION=0.1.1
# fork 用户可把更新检测指向自己的仓库
# MOE_UPDATE_REPO=lbls741/ServerMoe

# 入站收割策略（「微信→本项目」方向）：
#   resident（默认）= 进程内常驻 monitor 长轮询（Docker/裸机形态）
#   cron  = Cloudflare Workers 定时收割（Workers 形态默认值，最低 60 秒）
#   do    = Cloudflare Durable Object alarm 链收割（最低 10 秒，见 wrangler.jsonc）
# 注意：自部署设置 cron/do 不生效（自动回退 resident）；Workers 上设置 resident 自动回退 cron
# MOE_INGEST_MODE=resident

# 定时收割默认间隔（秒，10–86400）。实际生效值以管理页「入站轮询」设置（settings 表）优先，
# 改频率无需重新部署。D1 免费额度（10 万写/天）足以支撑 1 分钟级轮询
# MOE_POLL_INTERVAL_SEC=300

# 按需收割（方案3，on/off）：未预热时推送前抢租约做一次 ≤5s 的短收割刷新 context_token，
# 收割到消息即重试发送，否则按原语义入 outbox 排队。仅 cron/do 模式生效
# MOE_ONDEMAND_HARVEST=off
